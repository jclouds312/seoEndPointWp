
# Database (Replit PostgreSQL - automatically configured)
DATABASE_URL=postgresql://user:password@host:port/database

# Session Secret (generate a random string)
SESSION_SECRET=change_this_to_a_random_secret_key_minimum_32_characters

# Optional: Google AI (if using Gemini)
GOOGLE_AI_API_KEY=your_google_ai_key

# Optional: OpenAI (if using GPT)
OPENAI_API_KEY=your_openai_key

# WordPress Integration (configured in Settings UI)
# These can also be set here instead of the UI

# n8n Integration (configured in Settings UI)
# N8N_WEBHOOK_URL=your_n8n_webhook_url

# Port (automatically set by Replit)
PORT=5000
